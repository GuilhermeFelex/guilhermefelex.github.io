---
/**
 * Currículo para impressão, gerado a partir dos mesmos textos do site.
 * scripts/build-cv.mjs abre /cv/ e /en/cv/ depois da build e salva o PDF em dist/.
 */
import '@fontsource-variable/manrope';
import { site, stack } from '../data/site';
import { content } from '../i18n/content';
import { homeUrl, languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const siteUrl = new URL(homeUrl(lang), Astro.site);
const strip = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={t.cv.description} />
    <title>{t.cv.title}</title>
  </head>
  <body>
    <main class="cv">
      <header class="cv-header">
        <h1>{site.fullName}</h1>
        <p class="cv-role">{t.meta.role}</p>
        <ul class="cv-contact">
          <li>{t.cv.location}</li>
          <li><a href="#" data-mail-user={site.email.user} data-mail-domain={site.email.domain} data-mail-text>{t.contact.emailFallback}</a></li>
          <li><a href={site.social.linkedin}>{strip(site.social.linkedin)}</a></li>
          <li><a href={site.social.github}>{strip(site.social.github)}</a></li>
          <li><a href={siteUrl.href}>{strip(siteUrl.href)}</a></li>
        </ul>
      </header>

      <section>
        <h2>{t.cv.summary}</h2>
        <p>{t.about.introBefore}{site.fullName}{t.about.introAfter}</p>
        <p>{t.about.body}</p>
      </section>

      <section>
        <h2>{t.cv.experience}</h2>
        {t.career.items.map((item) => (
          <article class="cv-item">
            <div class="cv-item-head">
              <h3>{item.company} <span>· {item.role}</span></h3>
              <span class="cv-period">{item.period}</span>
            </div>
            <p>{item.description}</p>
          </article>
        ))}
      </section>

      <section>
        <h2>{t.cv.projects}</h2>
        {t.projects.items.map((project) => (
          <article class="cv-item">
            <div class="cv-item-head">
              <h3>{project.title}</h3>
              <span class="cv-period">{project.context}</span>
            </div>
            <p>{project.description}</p>
            <ul>
              {project.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </article>
        ))}
      </section>

      <section>
        <h2>{t.cv.skills}</h2>
        <dl class="cv-skills">
          {t.services.items.map((item) => (
            <>
              <dt>{item.title}</dt>
              <dd>{item.tags.join(', ')}</dd>
            </>
          ))}
          <dt>{t.stack.label}</dt>
          <dd>{stack.map((technology) => technology.name).join(', ')}</dd>
        </dl>
      </section>

      <section class="cv-columns">
        <div>
          <h2>{t.career.educationLabel}</h2>
          <ul>{t.career.education.map((entry) => <li>{entry}</li>)}</ul>
        </div>
        <div>
          <h2>{t.career.certificationsLabel}</h2>
          <ul>{t.career.certifications.map((entry) => <li>{entry}</li>)}</ul>
        </div>
        <div>
          <h2>{t.career.languagesLabel}</h2>
          <p>{t.career.languages}</p>
        </div>
      </section>
    </main>

    <script>
      import { hydrateEmail } from '../scripts/email';
      hydrateEmail();
    </script>
  </body>
</html>

<style is:global>
  /* Folha de impressão A4, independente do tema escuro do site. */
  @page { size: A4; margin: 14mm 15mm; }
  * { box-sizing: border-box; }
  html { background: #fff; }
  body { margin: 0; color: #15202b; font: 10pt/1.5 'Manrope Variable', 'Helvetica Neue', Arial, sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  a { color: inherit; text-decoration: none; }
  .cv { max-width: 180mm; margin: 0 auto; padding: 12mm 0; }
  @media print { .cv { padding: 0; } }
  .cv-header { padding-bottom: 10px; border-bottom: 2px solid #0b7cbf; }
  .cv-header h1 { margin: 0; font-size: 22pt; font-weight: 600; letter-spacing: -.02em; }
  .cv-role { margin: 2px 0 8px; color: #0b6a9f; font-weight: 600; }
  .cv-contact { display: flex; flex-wrap: wrap; gap: 2px 16px; margin: 0; padding: 0; color: #3b4a56; font-size: 9pt; list-style: none; }
  section { margin-top: 14px; }
  h2 { margin: 0 0 6px; color: #0b6a9f; font-size: 10pt; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  p { margin: 0 0 6px; }
  .cv-item { margin-bottom: 9px; break-inside: avoid; }
  .cv-item-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .cv-item h3 { margin: 0 0 2px; font-size: 10.5pt; font-weight: 600; }
  .cv-item h3 span { color: #3b4a56; font-weight: 500; }
  .cv-period { flex: none; color: #3b4a56; font-size: 9pt; }
  ul { margin: 0; padding-left: 16px; }
  li { margin-bottom: 2px; }
  .cv-skills { display: grid; grid-template-columns: 42mm 1fr; gap: 3px 10px; margin: 0; }
  .cv-skills dt { font-weight: 600; }
  .cv-skills dd { margin: 0; color: #3b4a56; }
  .cv-columns { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 16px; break-inside: avoid; }
</style>

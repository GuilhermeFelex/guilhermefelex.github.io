---
import { Image } from 'astro:assets';
import emblem from '../assets/brand/emblema-f.png';
import { site } from '../data/site';
import { content } from '../i18n/content';
import { homeUrl, languages, otherLang, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { header } = content[lang];
const alternate = otherLang(lang);
---

<header class="site-header" data-header>
  <a class="brand" href="#top" aria-label={header.brandLabel}>
    <!-- Emblema branco com sombra do kit v6, reduzido na build para o tamanho exibido (2x). -->
    <Image class="brand-mark" src={emblem} width={76} height={76} format="webp" alt="" loading="eager" />
    <span class="brand-name">{site.brand}</span>
  </a>

  <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-navigation">
    <span>{header.menu}</span>
    <span class="menu-icon" aria-hidden="true"></span>
  </button>

  <nav id="site-navigation" class="site-nav" aria-label={header.navLabel}>
    <a href="#sobre">{header.nav.about}</a>
    <a href="#servicos">{header.nav.services}</a>
    <a href="#projetos">{header.nav.projects}</a>
    <a href="#trajetoria">{header.nav.career}</a>
    <a href="#contato">{header.nav.contact}</a>
  </nav>

  <!-- Fora do menu móvel para ficar sempre a um toque de distância. -->
  <a
    class="lang-switch"
    href={homeUrl(alternate)}
    hreflang={languages[alternate].htmlLang}
    lang={languages[alternate].htmlLang}
    aria-label={header.switchLabel}
    data-goatcounter-click={`idioma-${alternate}`}
  >
    {languages[alternate].short}
  </a>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const navigation = document.querySelector<HTMLElement>('.site-nav');
  const brand = document.querySelector<HTMLElement>('.brand');
  const langSwitch = document.querySelector<HTMLElement>('.lang-switch');
  const links = document.querySelectorAll<HTMLAnchorElement>('.site-nav a');
  const mobileMenu = window.matchMedia('(max-width: 720px)');
  const inactiveContent = document.querySelectorAll<HTMLElement>('main, .site-footer');

  /**
   * Sincroniza os atributos visuais e de acessibilidade do menu móvel.
   * Em desktop, o menu é sempre visível e não deve receber `aria-hidden`.
   */
  const setMenuState = (isOpen: boolean, restoreButtonFocus = false) => {
    if (!mobileMenu.matches) {
      button?.setAttribute('aria-expanded', 'false');
      header?.classList.remove('menu-open');
      document.body.classList.remove('nav-open');
      navigation?.removeAttribute('aria-hidden');
      brand?.removeAttribute('inert');
      langSwitch?.removeAttribute('inert');
      inactiveContent.forEach((element) => element.removeAttribute('inert'));
      return;
    }

    button?.setAttribute('aria-expanded', String(isOpen));
    header?.classList.toggle('menu-open', isOpen);
    document.body.classList.toggle('nav-open', isOpen);
    navigation?.setAttribute('aria-hidden', String(!isOpen));

    // `inert` impede que Tab alcance o conteúdo que está visualmente atrás do menu aberto.
    brand?.toggleAttribute('inert', isOpen);
    langSwitch?.toggleAttribute('inert', isOpen);
    inactiveContent.forEach((element) => element.toggleAttribute('inert', isOpen));

    if (isOpen) {
      requestAnimationFrame(() => links[0]?.focus());
    } else if (restoreButtonFocus) {
      button?.focus();
    }
  };

  button?.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    setMenuState(!isOpen);
  });

  links.forEach((link) => link.addEventListener('click', () => setMenuState(false)));
  window.addEventListener('keydown', (event) => {
    const isOpen = mobileMenu.matches && button?.getAttribute('aria-expanded') === 'true';
    if (!isOpen) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      setMenuState(false, true);
      return;
    }

    if (event.key !== 'Tab') return;

    // O botão e os links formam o único ciclo de foco enquanto o menu estiver aberto.
    const focusableElements = [button, ...links].filter(Boolean) as HTMLElement[];
    const first = focusableElements[0];
    const last = focusableElements.at(-1);
    if (!first || !last) return;

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  // Ao sair do breakpoint móvel, remove o estado acessível usado pelo menu sobreposto.
  mobileMenu.addEventListener('change', () => setMenuState(false));
  setMenuState(false);

  // Cabeçalho fixo: ganha fundo e fica mais compacto depois do início da página.
  const syncScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  syncScrolled();
  window.addEventListener('scroll', syncScrolled, { passive: true });

  // Destaca no menu a seção que ocupa o centro da tela.
  const linkBySection = new Map(
    [...links].map((link) => [link.hash.slice(1), link] as const)
  );
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const link = linkBySection.get(entry.target.id);
        if (!link) return;
        if (entry.isIntersecting) {
          links.forEach((item) => item.removeAttribute('aria-current'));
          link.setAttribute('aria-current', 'true');
        } else if (link.getAttribute('aria-current')) {
          link.removeAttribute('aria-current');
        }
      });
    },
    { rootMargin: '-45% 0px -50% 0px' }
  );
  linkBySection.forEach((_, id) => {
    const section = document.getElementById(id);
    if (section) sectionObserver.observe(section);
  });
</script>

---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { expertise, projects, site, stack } from '../data/site';

const socialLinks = [
  { label: 'GitHub', href: site.social.github },
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'Instagram', href: site.social.instagram }
].filter((item) => item.href);

const year = new Date().getFullYear();
---

<BaseLayout
  title="FelexTech | Guilherme Felex — Integração, Automação e IA"
  description="FelexTech, por Guilherme Felex: integrações, automação, RPA e agentes de IA para times de operação."
>
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
  <div class="page-shell" id="top">
    <Header />

    <main id="conteudo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-kicker reveal">
          <span class="signal" aria-hidden="true"></span>
          <span>Integração · Automação · IA</span>
          <span class="hero-location">{site.location}</span>
        </div>

        <div class="hero-copy">
          <h1 id="hero-title" class="hero-title reveal">
            Eu construo sistemas que <span>conectam, automatizam</span> e pensam.
          </h1>

          <div class="hero-bottom reveal">
            <p>
              Ajudo times de operação a conectar sistemas, automatizar rotinas e aplicar IA em
              processos que ainda dependem de trabalho manual.
            </p>
            <div class="hero-actions">
              <a class="text-link" href="#projetos">
                Ver projetos
                <span aria-hidden="true">↘</span>
              </a>
              <a class="hero-contact" href="#contato">Contato <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>

        <div class="hero-visual reveal">
          <HeroDiagram />
        </div>
      </section>

      <section class="about section" id="sobre" aria-labelledby="about-title">
        <SectionTitle number="01" label="Sobre" />
        <div class="about-grid">
          <h2 id="about-title" class="about-lead reveal">
            Tecnologia só importa quando resolve o que está travando a operação.
          </h2>
          <div class="about-copy reveal">
            <p>
              Sou <strong>Guilherme Felex</strong>, desenvolvedor focado em integrações, RPA, agentes
              de IA e aplicações empresariais. Meu trabalho começa entendendo o processo — e termina
              com uma solução que as pessoas conseguem usar, manter e evoluir.
            </p>
            <p>
              Atuo entre negócio e engenharia: conecto APIs, ERPs, CRMs, marketplaces e modelos
              de IA para reduzir trabalho manual, organizar dados e criar novas capacidades.
            </p>
          </div>
        </div>
      </section>

      <section class="expertise section" id="especialidades" aria-labelledby="expertise-title">
        <SectionTitle number="02" label="Especialidades" as="h2" id="expertise-title" />
        <div class="expertise-list">
          {expertise.map((item) => (
            <article class="expertise-item reveal">
              <Icon name={item.icon} class="feature-icon" aria-hidden="true" />
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
              <ul aria-label={`Tecnologias de ${item.title}`}>
                {item.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="projects section" id="projetos" aria-labelledby="projects-title">
        <SectionTitle number="03" label="Frentes de produto" />
        <div class="projects-intro reveal">
          <h2 id="projects-title">Soluções para operações reais.</h2>
          <p>Quatro frentes que combinam CRM, ERP, automação e IA aplicada à operação.</p>
        </div>

        <div class="project-list">
          {projects.map((project) => (
            <article class="project-item reveal">
              <div class="project-heading">
                <span class="item-number">{project.number}</span>
                <h3>{project.title}</h3>
              </div>
              <p>{project.description}</p>
              <ul class="project-tags" aria-label={`Tecnologias de ${project.title}`}>
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <p class="projects-evidence reveal">
          Implementações e experimentos públicos disponíveis no
          <a href={site.social.github} target="_blank" rel="noreferrer">GitHub</a>.
        </p>
      </section>

      <section class="stack section" id="stack" aria-labelledby="stack-title">
        <SectionTitle number="04" label="Stack atual" />
        <h2 id="stack-title" class="stack-title reveal">
          Ferramentas mudam. <span>Critério permanece.</span>
        </h2>
        <ul class="stack-list reveal">
          {stack.map((technology) => (
            <li style={`--brand: ${technology.color}`}>
              <Icon name={technology.icon} class="stack-mark" aria-hidden="true" />
              {technology.name}
            </li>
          ))}
        </ul>
      </section>

      <section class="contact section" id="contato" aria-labelledby="contact-title">
        <div class="contact-eyebrow reveal">
          <span class="signal" aria-hidden="true"></span>
          <span>Disponível para novos projetos</span>
        </div>
        <h2 id="contact-title" class="contact-title reveal">
          Tem um processo que pode funcionar melhor?
        </h2>
        <div class="contact-bottom reveal">
          <p>Vamos conversar sobre o problema antes de falar sobre a ferramenta.</p>
          <div class="contact-actions">
            <a class="contact-link" href={`mailto:${site.email}`}>
              Iniciar conversa
              <span aria-hidden="true">↗</span>
            </a>
            <a class="contact-secondary" href={site.social.linkedin} target="_blank" rel="noreferrer">
              <Icon name="lucide:linkedin" aria-hidden="true" />
              Conversar no LinkedIn
              <span aria-hidden="true">↗</span>
            </a>
            <div class="contact-email-row">
              <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
              <!-- Nem todo visitante tem um app de email configurado para abrir o mailto. -->
              <button class="copy-email" type="button" data-copy={site.email}>
                <Icon name="lucide:copy" aria-hidden="true" />
                <span data-copy-label>Copiar</span>
              </button>
            </div>
            <span class="contact-location">{site.location} · disponível para trabalho remoto</span>
            <span class="sr-only" aria-live="polite" data-copy-status></span>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <strong>FELEX</strong>
        <span>© {year} Guilherme Felex · Construir. Integrar. Automatizar.</span>
      </div>
      <div class="footer-links">
        {socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
        ))}
      </div>
      <a href="#top">Voltar ao topo ↑</a>
    </footer>
  </div>

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const elements = document.querySelectorAll<HTMLElement>('.reveal');

    if (reducedMotion) {
      elements.forEach((element) => element.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );

      elements.forEach((element) => observer.observe(element));
    }

    // Copia o email e confirma visualmente e para leitores de tela.
    const copyButton = document.querySelector<HTMLButtonElement>('[data-copy]');
    const copyLabel = copyButton?.querySelector<HTMLElement>('[data-copy-label]');
    const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
    let resetLabel: number | undefined;

    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyButton.dataset.copy ?? '');
      } catch {
        return;
      }
      copyButton.classList.add('is-copied');
      if (copyLabel) copyLabel.textContent = 'Copiado';
      if (copyStatus) copyStatus.textContent = 'Email copiado para a área de transferência.';
      window.clearTimeout(resetLabel);
      resetLabel = window.setTimeout(() => {
        copyButton.classList.remove('is-copied');
        if (copyLabel) copyLabel.textContent = 'Copiar';
        if (copyStatus) copyStatus.textContent = '';
      }, 2200);
    });
  </script>
</BaseLayout>

---
/**
 * Página 404. O GitHub Pages serve um único 404.html para qualquer caminho inexistente,
 * então ela fala os dois idiomas e leva de volta para a página inicial de cada um.
 */
import { Image } from 'astro:assets';
import emblem from '../assets/brand/emblema-f.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { homeUrl } from '../i18n/ui';
---

<BaseLayout
  lang="pt"
  title={`Página não encontrada | ${site.brand}`}
  description="O endereço acessado não existe. Volte para a página inicial da FelexTech."
  noindex
>
  <div class="page-shell">
    <header class="not-found-header">
      <a class="brand" href={homeUrl('pt')}>
        <Image class="brand-mark" src={emblem} width={76} height={76} format="webp" alt="" loading="eager" />
        <span class="brand-name">{site.brand}</span>
      </a>
    </header>

    <main class="not-found">
      <p class="not-found-code" aria-hidden="true">404</p>
      <div class="not-found-grid">
        <section aria-labelledby="not-found-pt">
          <h1 id="not-found-pt">Página não encontrada.</h1>
          <p>O endereço pode ter mudado ou não existir mais.</p>
          <a class="text-link" href={homeUrl('pt')}>Voltar para o início <span aria-hidden="true">→</span></a>
        </section>
        <section lang="en" aria-labelledby="not-found-en">
          <h2 id="not-found-en">Page not found.</h2>
          <p>The address may have changed or no longer exists.</p>
          <a class="hero-contact" href={homeUrl('en')}>Go to the English home page <span aria-hidden="true">→</span></a>
        </section>
      </div>
    </main>
  </div>
</BaseLayout>

---
// Fontes servidas pelo próprio site: sem requisições externas nem bloqueio do Google Fonts.
import '@fontsource-variable/manrope';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
// A imagem usa URL absoluta porque LinkedIn, WhatsApp e outros crawlers não resolvem caminhos relativos.
const socialImage = new URL(`${basePath}images/og-felex.jpg`, Astro.site);
// Dados estruturados conectam a pessoa, o nome curto "Felex" e a marca FelexTech nas buscas.
const profileSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${canonical.origin}/#guilherme-felex`,
      name: 'Guilherme Felex',
      alternateName: 'Felex',
      jobTitle: site.role,
      url: canonical.href,
      email: site.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'São Paulo',
        addressCountry: 'BR'
      },
      sameAs: [site.social.github, site.social.linkedin].filter(Boolean),
      worksFor: { '@id': `${canonical.origin}/#felextech` }
    },
    {
      '@type': 'Organization',
      '@id': `${canonical.origin}/#felextech`,
      name: 'FelexTech',
      alternateName: 'Felex',
      url: canonical.href,
      founder: { '@id': `${canonical.origin}/#guilherme-felex` },
      sameAs: [site.social.instagram].filter(Boolean)
    }
  ]
});
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071015" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <!-- F branco do kit v6 (cópias em public/favicons) para abas e atalhos. -->
    <link rel="icon" href={`${basePath}favicons/favicon.ico`} sizes="any" />
    <link rel="icon" href={`${basePath}favicons/favicon_32.png`} type="image/png" sizes="32x32" />
    <link rel="icon" href={`${basePath}favicons/favicon_16.png`} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={`${basePath}favicons/favicon_180.png`} sizes="180x180" />
    <!-- Metadados usados para criar uma prévia consistente ao compartilhar o portfólio. -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="FelexTech" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="FelexTech — Integração, Automação e IA" />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="FelexTech — Integração, Automação e IA" />
    <script type="application/ld+json" set:html={profileSchema}></script>
    <!-- Marca a página como "com JS" antes da pintura; sem JS, os blocos .reveal ficam visíveis. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

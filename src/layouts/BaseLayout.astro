---
// Fontes servidas pelo próprio site: sem requisições externas nem bloqueio do Google Fonts.
import '@fontsource-variable/manrope';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { site } from '../data/site';
import { content } from '../i18n/content';
import { homeUrl, languages, otherLang, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { meta } = content[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(homeUrl('pt'), Astro.site);
const alternate = otherLang(lang);
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
// A imagem usa URL absoluta porque LinkedIn, WhatsApp e outros crawlers não resolvem caminhos relativos.
const socialImage = new URL(`${basePath}images/og-felex.jpg`, Astro.site);
// Dados estruturados conectam a pessoa, o nome curto "Felex" e a marca FelexTech nas buscas.
const profileSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${home.href}#guilherme-felex`,
      name: site.fullName,
      alternateName: site.name,
      jobTitle: meta.role,
      url: home.href,
      email: site.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'São Paulo',
        addressCountry: 'BR'
      },
      sameAs: [site.social.github, site.social.linkedin].filter(Boolean),
      worksFor: { '@id': `${home.href}#felextech` }
    },
    {
      '@type': 'Organization',
      '@id': `${home.href}#felextech`,
      name: site.brand,
      alternateName: site.name,
      url: home.href,
      founder: { '@id': `${home.href}#guilherme-felex` },
      sameAs: [site.social.instagram].filter(Boolean)
    }
  ]
});
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#071015" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <!-- Versões por idioma: os buscadores mostram a página certa para cada público. -->
    {Object.entries(languages).map(([code, language]) => (
      <link rel="alternate" hreflang={language.htmlLang} href={new URL(homeUrl(code as Lang), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={home} />
    <!-- F branco do kit v6 (cópias em public/favicons) para abas e atalhos. -->
    <link rel="icon" href={`${basePath}favicons/favicon.ico`} sizes="any" />
    <link rel="icon" href={`${basePath}favicons/favicon_32.png`} type="image/png" sizes="32x32" />
    <link rel="icon" href={`${basePath}favicons/favicon_16.png`} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={`${basePath}favicons/favicon_180.png`} sizes="180x180" />
    <!-- Metadados usados para criar uma prévia consistente ao compartilhar o portfólio. -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    <meta property="og:locale:alternate" content={languages[alternate].ogLocale} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={meta.imageAlt} />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={meta.imageAlt} />
    <script type="application/ld+json" set:html={profileSchema}></script>
    <!-- Marca a página como "com JS" antes da pintura; sem JS, os blocos .reveal ficam visíveis. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Analytics />
    <title>{meta.title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
